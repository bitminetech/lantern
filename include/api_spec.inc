/*
 * The keys of getSpec (docs/reference/beacon-api.md, lantern_node_api_event), in the order of the answer:
 * m name, kind, value. The kind's arg is the kind / 256. From consensus-specs v1.7.0-beta.4
 * (aa16bb4): the keys of configs/<preset>.yaml that lantern_config_parse reads, in file order
 * (the same in both); presets/<preset>/<fork>.yaml, phase0 to fulu; the Constants tables of
 * specs/<fork>/beacon-chain.md, phase0 to fulu.
 */
.set SPEC_NUMBER, 0         /* the value, a number */
.set SPEC_HEX, 1            /* arg bytes: the value's bytes, little endian, then zero bytes */
.set SPEC_TEXT, 2           /* arg bytes of text: the value's bytes, little endian */
.set SPEC_LIST, 3           /* arg numbers: the value's bytes, little endian */
.set SPEC_CONFIG, 4         /* the config's field at the value's offset, of the CONFIG_KIND_* arg */
.set SPEC_SECONDS, 5        /* the config's u64 at the value's offset, / 1000 */
.set SPEC_SCHEDULE, 6       /* the config's BLOB_SCHEDULE */
.macro API_SPEC_KEYS m
    /* config */
    \m PRESET_BASE, SPEC_CONFIG + (CONFIG_KIND_TEXT << 8), CONFIG_PRESET_BASE
    \m CONFIG_NAME, SPEC_CONFIG + (CONFIG_KIND_TEXT << 8), CONFIG_CONFIG_NAME
    \m TERMINAL_TOTAL_DIFFICULTY, SPEC_CONFIG + (CONFIG_KIND_UINT256 << 8), CONFIG_TERMINAL_TOTAL_DIFFICULTY
    \m TERMINAL_BLOCK_HASH, SPEC_CONFIG + (CONFIG_KIND_HASH32 << 8), CONFIG_TERMINAL_BLOCK_HASH
    \m TERMINAL_BLOCK_HASH_ACTIVATION_EPOCH, SPEC_CONFIG, CONFIG_TERMINAL_BLOCK_HASH_ACTIVATION_EPOCH
    \m MIN_GENESIS_ACTIVE_VALIDATOR_COUNT, SPEC_CONFIG, CONFIG_MIN_GENESIS_ACTIVE_VALIDATOR_COUNT
    \m MIN_GENESIS_TIME, SPEC_CONFIG, CONFIG_MIN_GENESIS_TIME
    \m GENESIS_FORK_VERSION, SPEC_CONFIG + (CONFIG_KIND_VERSION << 8), CONFIG_GENESIS_FORK_VERSION
    \m GENESIS_DELAY, SPEC_CONFIG, CONFIG_GENESIS_DELAY
    \m ALTAIR_FORK_VERSION, SPEC_CONFIG + (CONFIG_KIND_VERSION << 8), CONFIG_ALTAIR_FORK_VERSION
    \m ALTAIR_FORK_EPOCH, SPEC_CONFIG, CONFIG_ALTAIR_FORK_EPOCH
    \m BELLATRIX_FORK_VERSION, SPEC_CONFIG + (CONFIG_KIND_VERSION << 8), CONFIG_BELLATRIX_FORK_VERSION
    \m BELLATRIX_FORK_EPOCH, SPEC_CONFIG, CONFIG_BELLATRIX_FORK_EPOCH
    \m CAPELLA_FORK_VERSION, SPEC_CONFIG + (CONFIG_KIND_VERSION << 8), CONFIG_CAPELLA_FORK_VERSION
    \m CAPELLA_FORK_EPOCH, SPEC_CONFIG, CONFIG_CAPELLA_FORK_EPOCH
    \m DENEB_FORK_VERSION, SPEC_CONFIG + (CONFIG_KIND_VERSION << 8), CONFIG_DENEB_FORK_VERSION
    \m DENEB_FORK_EPOCH, SPEC_CONFIG, CONFIG_DENEB_FORK_EPOCH
    \m ELECTRA_FORK_VERSION, SPEC_CONFIG + (CONFIG_KIND_VERSION << 8), CONFIG_ELECTRA_FORK_VERSION
    \m ELECTRA_FORK_EPOCH, SPEC_CONFIG, CONFIG_ELECTRA_FORK_EPOCH
    \m FULU_FORK_VERSION, SPEC_CONFIG + (CONFIG_KIND_VERSION << 8), CONFIG_FULU_FORK_VERSION
    \m FULU_FORK_EPOCH, SPEC_CONFIG, CONFIG_FULU_FORK_EPOCH
    \m SECONDS_PER_SLOT, SPEC_SECONDS, CONFIG_SLOT_DURATION_MS
    \m SLOT_DURATION_MS, SPEC_CONFIG, CONFIG_SLOT_DURATION_MS
    \m SECONDS_PER_ETH1_BLOCK, SPEC_CONFIG, CONFIG_SECONDS_PER_ETH1_BLOCK
    \m MIN_VALIDATOR_WITHDRAWABILITY_DELAY, SPEC_CONFIG, CONFIG_MIN_VALIDATOR_WITHDRAWABILITY_DELAY
    \m SHARD_COMMITTEE_PERIOD, SPEC_CONFIG, CONFIG_SHARD_COMMITTEE_PERIOD
    \m ETH1_FOLLOW_DISTANCE, SPEC_CONFIG, CONFIG_ETH1_FOLLOW_DISTANCE
    \m PROPOSER_REORG_CUTOFF_BPS, SPEC_CONFIG, CONFIG_PROPOSER_REORG_CUTOFF_BPS
    \m ATTESTATION_DUE_BPS, SPEC_CONFIG, CONFIG_ATTESTATION_DUE_BPS
    \m AGGREGATE_DUE_BPS, SPEC_CONFIG, CONFIG_AGGREGATE_DUE_BPS
    \m SYNC_MESSAGE_DUE_BPS, SPEC_CONFIG, CONFIG_SYNC_MESSAGE_DUE_BPS
    \m CONTRIBUTION_DUE_BPS, SPEC_CONFIG, CONFIG_CONTRIBUTION_DUE_BPS
    \m INACTIVITY_SCORE_BIAS, SPEC_CONFIG, CONFIG_INACTIVITY_SCORE_BIAS
    \m INACTIVITY_SCORE_RECOVERY_RATE, SPEC_CONFIG, CONFIG_INACTIVITY_SCORE_RECOVERY_RATE
    \m EJECTION_BALANCE, SPEC_CONFIG, CONFIG_EJECTION_BALANCE
    \m MIN_PER_EPOCH_CHURN_LIMIT, SPEC_CONFIG, CONFIG_MIN_PER_EPOCH_CHURN_LIMIT
    \m CHURN_LIMIT_QUOTIENT, SPEC_CONFIG, CONFIG_CHURN_LIMIT_QUOTIENT
    \m MAX_PER_EPOCH_ACTIVATION_CHURN_LIMIT, SPEC_CONFIG, CONFIG_MAX_PER_EPOCH_ACTIVATION_CHURN_LIMIT
    \m MIN_PER_EPOCH_CHURN_LIMIT_ELECTRA, SPEC_CONFIG, CONFIG_MIN_PER_EPOCH_CHURN_LIMIT_ELECTRA
    \m MAX_PER_EPOCH_ACTIVATION_EXIT_CHURN_LIMIT, SPEC_CONFIG, CONFIG_MAX_PER_EPOCH_ACTIVATION_EXIT_CHURN_LIMIT
    \m PROPOSER_SCORE_BOOST, SPEC_CONFIG, CONFIG_PROPOSER_SCORE_BOOST
    \m REORG_HEAD_WEIGHT_THRESHOLD, SPEC_CONFIG, CONFIG_REORG_HEAD_WEIGHT_THRESHOLD
    \m REORG_PARENT_WEIGHT_THRESHOLD, SPEC_CONFIG, CONFIG_REORG_PARENT_WEIGHT_THRESHOLD
    \m REORG_MAX_EPOCHS_SINCE_FINALIZATION, SPEC_CONFIG, CONFIG_REORG_MAX_EPOCHS_SINCE_FINALIZATION
    \m DEPOSIT_CHAIN_ID, SPEC_CONFIG, CONFIG_DEPOSIT_CHAIN_ID
    \m DEPOSIT_NETWORK_ID, SPEC_CONFIG, CONFIG_DEPOSIT_NETWORK_ID
    \m DEPOSIT_CONTRACT_ADDRESS, SPEC_CONFIG + (CONFIG_KIND_ADDRESS << 8), CONFIG_DEPOSIT_CONTRACT_ADDRESS
    \m MAX_PAYLOAD_SIZE, SPEC_CONFIG, CONFIG_MAX_PAYLOAD_SIZE
    \m MAX_REQUEST_BLOCKS, SPEC_CONFIG, CONFIG_MAX_REQUEST_BLOCKS
    \m EPOCHS_PER_SUBNET_SUBSCRIPTION, SPEC_CONFIG, CONFIG_EPOCHS_PER_SUBNET_SUBSCRIPTION
    \m ATTESTATION_PROPAGATION_SLOT_RANGE, SPEC_CONFIG, CONFIG_ATTESTATION_PROPAGATION_SLOT_RANGE
    \m MAXIMUM_GOSSIP_CLOCK_DISPARITY, SPEC_CONFIG, CONFIG_MAXIMUM_GOSSIP_CLOCK_DISPARITY
    \m MESSAGE_DOMAIN_INVALID_SNAPPY, SPEC_CONFIG + (CONFIG_KIND_VERSION << 8), CONFIG_MESSAGE_DOMAIN_INVALID_SNAPPY
    \m MESSAGE_DOMAIN_VALID_SNAPPY, SPEC_CONFIG + (CONFIG_KIND_VERSION << 8), CONFIG_MESSAGE_DOMAIN_VALID_SNAPPY
    \m SUBNETS_PER_NODE, SPEC_CONFIG, CONFIG_SUBNETS_PER_NODE
    \m ATTESTATION_SUBNET_COUNT, SPEC_CONFIG, CONFIG_ATTESTATION_SUBNET_COUNT
    \m ATTESTATION_SUBNET_EXTRA_BITS, SPEC_CONFIG, CONFIG_ATTESTATION_SUBNET_EXTRA_BITS
    \m MAX_REQUEST_BLOCKS_DENEB, SPEC_CONFIG, CONFIG_MAX_REQUEST_BLOCKS_DENEB
    \m MIN_EPOCHS_FOR_BLOB_SIDECARS_REQUESTS, SPEC_CONFIG, CONFIG_MIN_EPOCHS_FOR_BLOB_SIDECARS_REQUESTS
    \m BLOB_SIDECAR_SUBNET_COUNT, SPEC_CONFIG, CONFIG_BLOB_SIDECAR_SUBNET_COUNT
    \m MAX_BLOBS_PER_BLOCK, SPEC_CONFIG, CONFIG_MAX_BLOBS_PER_BLOCK
    \m BLOB_SIDECAR_SUBNET_COUNT_ELECTRA, SPEC_CONFIG, CONFIG_BLOB_SIDECAR_SUBNET_COUNT_ELECTRA
    \m MAX_BLOBS_PER_BLOCK_ELECTRA, SPEC_CONFIG, CONFIG_MAX_BLOBS_PER_BLOCK_ELECTRA
    \m NUMBER_OF_CUSTODY_GROUPS, SPEC_CONFIG, CONFIG_NUMBER_OF_CUSTODY_GROUPS
    \m DATA_COLUMN_SIDECAR_SUBNET_COUNT, SPEC_CONFIG, CONFIG_DATA_COLUMN_SIDECAR_SUBNET_COUNT
    \m SAMPLES_PER_SLOT, SPEC_CONFIG, CONFIG_SAMPLES_PER_SLOT
    \m CUSTODY_REQUIREMENT, SPEC_CONFIG, CONFIG_CUSTODY_REQUIREMENT
    \m VALIDATOR_CUSTODY_REQUIREMENT, SPEC_CONFIG, CONFIG_VALIDATOR_CUSTODY_REQUIREMENT
    \m BALANCE_PER_ADDITIONAL_CUSTODY_GROUP, SPEC_CONFIG, CONFIG_BALANCE_PER_ADDITIONAL_CUSTODY_GROUP
    \m MIN_EPOCHS_FOR_DATA_COLUMN_SIDECARS_REQUESTS, SPEC_CONFIG, CONFIG_MIN_EPOCHS_FOR_DATA_COLUMN_SIDECARS_REQUESTS
    \m BLOB_SCHEDULE, SPEC_SCHEDULE, 0
    /* preset: phase0 */
    \m MAX_COMMITTEES_PER_SLOT, SPEC_NUMBER, MAX_COMMITTEES_PER_SLOT
    \m TARGET_COMMITTEE_SIZE, SPEC_NUMBER, TARGET_COMMITTEE_SIZE
    \m MAX_VALIDATORS_PER_COMMITTEE, SPEC_NUMBER, MAX_VALIDATORS_PER_COMMITTEE
    \m SHUFFLE_ROUND_COUNT, SPEC_NUMBER, SHUFFLE_ROUND_COUNT
    \m HYSTERESIS_QUOTIENT, SPEC_NUMBER, HYSTERESIS_QUOTIENT
    \m HYSTERESIS_DOWNWARD_MULTIPLIER, SPEC_NUMBER, HYSTERESIS_DOWNWARD_MULTIPLIER
    \m HYSTERESIS_UPWARD_MULTIPLIER, SPEC_NUMBER, HYSTERESIS_UPWARD_MULTIPLIER
    \m MIN_DEPOSIT_AMOUNT, SPEC_NUMBER, MIN_DEPOSIT_AMOUNT
    \m MAX_EFFECTIVE_BALANCE, SPEC_NUMBER, MAX_EFFECTIVE_BALANCE
    \m EFFECTIVE_BALANCE_INCREMENT, SPEC_NUMBER, EFFECTIVE_BALANCE_INCREMENT
    \m MIN_ATTESTATION_INCLUSION_DELAY, SPEC_NUMBER, MIN_ATTESTATION_INCLUSION_DELAY
    \m SLOTS_PER_EPOCH, SPEC_NUMBER, SLOTS_PER_EPOCH
    \m MIN_SEED_LOOKAHEAD, SPEC_NUMBER, MIN_SEED_LOOKAHEAD
    \m MAX_SEED_LOOKAHEAD, SPEC_NUMBER, MAX_SEED_LOOKAHEAD
    \m EPOCHS_PER_ETH1_VOTING_PERIOD, SPEC_NUMBER, EPOCHS_PER_ETH1_VOTING_PERIOD
    \m SLOTS_PER_HISTORICAL_ROOT, SPEC_NUMBER, SLOTS_PER_HISTORICAL_ROOT
    \m MIN_EPOCHS_TO_INACTIVITY_PENALTY, SPEC_NUMBER, MIN_EPOCHS_TO_INACTIVITY_PENALTY
    \m EPOCHS_PER_HISTORICAL_VECTOR, SPEC_NUMBER, EPOCHS_PER_HISTORICAL_VECTOR
    \m EPOCHS_PER_SLASHINGS_VECTOR, SPEC_NUMBER, EPOCHS_PER_SLASHINGS_VECTOR
    \m HISTORICAL_ROOTS_LIMIT, SPEC_NUMBER, HISTORICAL_ROOTS_LIMIT
    \m VALIDATOR_REGISTRY_LIMIT, SPEC_NUMBER, VALIDATOR_REGISTRY_LIMIT
    \m BASE_REWARD_FACTOR, SPEC_NUMBER, BASE_REWARD_FACTOR
    \m WHISTLEBLOWER_REWARD_QUOTIENT, SPEC_NUMBER, WHISTLEBLOWER_REWARD_QUOTIENT
    \m PROPOSER_REWARD_QUOTIENT, SPEC_NUMBER, PROPOSER_REWARD_QUOTIENT
    \m INACTIVITY_PENALTY_QUOTIENT, SPEC_NUMBER, INACTIVITY_PENALTY_QUOTIENT
    \m MIN_SLASHING_PENALTY_QUOTIENT, SPEC_NUMBER, MIN_SLASHING_PENALTY_QUOTIENT
    \m PROPORTIONAL_SLASHING_MULTIPLIER, SPEC_NUMBER, PROPORTIONAL_SLASHING_MULTIPLIER
    \m MAX_PROPOSER_SLASHINGS, SPEC_NUMBER, MAX_PROPOSER_SLASHINGS
    \m MAX_ATTESTER_SLASHINGS, SPEC_NUMBER, MAX_ATTESTER_SLASHINGS
    \m MAX_ATTESTATIONS, SPEC_NUMBER, MAX_ATTESTATIONS
    \m MAX_DEPOSITS, SPEC_NUMBER, MAX_DEPOSITS
    \m MAX_VOLUNTARY_EXITS, SPEC_NUMBER, MAX_VOLUNTARY_EXITS
    /* preset: altair */
    \m INACTIVITY_PENALTY_QUOTIENT_ALTAIR, SPEC_NUMBER, INACTIVITY_PENALTY_QUOTIENT_ALTAIR
    \m MIN_SLASHING_PENALTY_QUOTIENT_ALTAIR, SPEC_NUMBER, MIN_SLASHING_PENALTY_QUOTIENT_ALTAIR
    \m PROPORTIONAL_SLASHING_MULTIPLIER_ALTAIR, SPEC_NUMBER, PROPORTIONAL_SLASHING_MULTIPLIER_ALTAIR
    \m SYNC_COMMITTEE_SIZE, SPEC_NUMBER, SYNC_COMMITTEE_SIZE
    \m EPOCHS_PER_SYNC_COMMITTEE_PERIOD, SPEC_NUMBER, EPOCHS_PER_SYNC_COMMITTEE_PERIOD
    \m MIN_SYNC_COMMITTEE_PARTICIPANTS, SPEC_NUMBER, MIN_SYNC_COMMITTEE_PARTICIPANTS
    \m UPDATE_TIMEOUT, SPEC_NUMBER, UPDATE_TIMEOUT
    /* preset: bellatrix */
    \m INACTIVITY_PENALTY_QUOTIENT_BELLATRIX, SPEC_NUMBER, INACTIVITY_PENALTY_QUOTIENT_BELLATRIX
    \m MIN_SLASHING_PENALTY_QUOTIENT_BELLATRIX, SPEC_NUMBER, MIN_SLASHING_PENALTY_QUOTIENT_BELLATRIX
    \m PROPORTIONAL_SLASHING_MULTIPLIER_BELLATRIX, SPEC_NUMBER, PROPORTIONAL_SLASHING_MULTIPLIER_BELLATRIX
    \m MAX_BYTES_PER_TRANSACTION, SPEC_NUMBER, MAX_BYTES_PER_TRANSACTION
    \m MAX_TRANSACTIONS_PER_PAYLOAD, SPEC_NUMBER, MAX_TRANSACTIONS_PER_PAYLOAD
    \m BYTES_PER_LOGS_BLOOM, SPEC_NUMBER, BYTES_PER_LOGS_BLOOM
    \m MAX_EXTRA_DATA_BYTES, SPEC_NUMBER, MAX_EXTRA_DATA_BYTES
    /* preset: capella */
    \m MAX_BLS_TO_EXECUTION_CHANGES, SPEC_NUMBER, MAX_BLS_TO_EXECUTION_CHANGES
    \m MAX_WITHDRAWALS_PER_PAYLOAD, SPEC_NUMBER, MAX_WITHDRAWALS_PER_PAYLOAD
    \m MAX_VALIDATORS_PER_WITHDRAWALS_SWEEP, SPEC_NUMBER, MAX_VALIDATORS_PER_WITHDRAWALS_SWEEP
    /* preset: deneb */
    \m MAX_BLOB_COMMITMENTS_PER_BLOCK, SPEC_NUMBER, MAX_BLOB_COMMITMENTS_PER_BLOCK
    \m KZG_COMMITMENT_INCLUSION_PROOF_DEPTH, SPEC_NUMBER, KZG_COMMITMENT_INCLUSION_PROOF_DEPTH
    \m FIELD_ELEMENTS_PER_BLOB, SPEC_NUMBER, FIELD_ELEMENTS_PER_BLOB
    /* preset: electra */
    \m MIN_ACTIVATION_BALANCE, SPEC_NUMBER, MIN_ACTIVATION_BALANCE
    \m MAX_EFFECTIVE_BALANCE_ELECTRA, SPEC_NUMBER, MAX_EFFECTIVE_BALANCE_ELECTRA
    \m MIN_SLASHING_PENALTY_QUOTIENT_ELECTRA, SPEC_NUMBER, MIN_SLASHING_PENALTY_QUOTIENT_ELECTRA
    \m WHISTLEBLOWER_REWARD_QUOTIENT_ELECTRA, SPEC_NUMBER, WHISTLEBLOWER_REWARD_QUOTIENT_ELECTRA
    \m PENDING_DEPOSITS_LIMIT, SPEC_NUMBER, PENDING_DEPOSITS_LIMIT
    \m PENDING_PARTIAL_WITHDRAWALS_LIMIT, SPEC_NUMBER, PENDING_PARTIAL_WITHDRAWALS_LIMIT
    \m PENDING_CONSOLIDATIONS_LIMIT, SPEC_NUMBER, PENDING_CONSOLIDATIONS_LIMIT
    \m MAX_ATTESTER_SLASHINGS_ELECTRA, SPEC_NUMBER, MAX_ATTESTER_SLASHINGS_ELECTRA
    \m MAX_ATTESTATIONS_ELECTRA, SPEC_NUMBER, MAX_ATTESTATIONS_ELECTRA
    \m MAX_DEPOSIT_REQUESTS_PER_PAYLOAD, SPEC_NUMBER, MAX_DEPOSIT_REQUESTS_PER_PAYLOAD
    \m MAX_WITHDRAWAL_REQUESTS_PER_PAYLOAD, SPEC_NUMBER, MAX_WITHDRAWAL_REQUESTS_PER_PAYLOAD
    \m MAX_CONSOLIDATION_REQUESTS_PER_PAYLOAD, SPEC_NUMBER, MAX_CONSOLIDATION_REQUESTS_PER_PAYLOAD
    \m MAX_PENDING_PARTIALS_PER_WITHDRAWALS_SWEEP, SPEC_NUMBER, MAX_PENDING_PARTIALS_PER_WITHDRAWALS_SWEEP
    \m MAX_PENDING_DEPOSITS_PER_EPOCH, SPEC_NUMBER, MAX_PENDING_DEPOSITS_PER_EPOCH
    /* preset: fulu */
    \m KZG_COMMITMENTS_INCLUSION_PROOF_DEPTH, SPEC_NUMBER, KZG_COMMITMENTS_INCLUSION_PROOF_DEPTH
    \m FIELD_ELEMENTS_PER_CELL, SPEC_NUMBER, FIELD_ELEMENTS_PER_CELL
    \m FIELD_ELEMENTS_PER_EXT_BLOB, SPEC_NUMBER, FIELD_ELEMENTS_PER_EXT_BLOB
    \m CELLS_PER_EXT_BLOB, SPEC_NUMBER, CELLS_PER_EXT_BLOB
    \m NUMBER_OF_COLUMNS, SPEC_NUMBER, NUMBER_OF_COLUMNS
    /* constants: phase0 */
    \m UINT64_MAX, SPEC_NUMBER, UINT64_MAX
    \m UINT64_MAX_SQRT, SPEC_NUMBER, UINT64_MAX_SQRT
    \m GENESIS_SLOT, SPEC_NUMBER, GENESIS_SLOT
    \m GENESIS_EPOCH, SPEC_NUMBER, GENESIS_EPOCH
    \m FAR_FUTURE_EPOCH, SPEC_NUMBER, FAR_FUTURE_EPOCH
    \m BASE_REWARDS_PER_EPOCH, SPEC_NUMBER, BASE_REWARDS_PER_EPOCH
    \m JUSTIFICATION_BITS_LENGTH, SPEC_NUMBER, JUSTIFICATION_BITS_LENGTH
    \m ENDIANNESS, SPEC_TEXT + (6 << 8), 0x656c7474696c    /* "little" */
    \m BLS_WITHDRAWAL_PREFIX, SPEC_HEX + (1 << 8), BLS_WITHDRAWAL_PREFIX
    \m ETH1_ADDRESS_WITHDRAWAL_PREFIX, SPEC_HEX + (1 << 8), ETH1_ADDRESS_WITHDRAWAL_PREFIX
